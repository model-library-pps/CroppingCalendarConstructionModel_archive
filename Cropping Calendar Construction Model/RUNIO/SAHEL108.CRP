NSPM2X = 100000.    ! Maximum number of spikelets per m2 ! average from Cotonou experiment, varieties IR64, FARO 35 (ITA212), Kogoni 91-1
NSJA   = 2000.     ! Juvenile spikelets per g-1 N at 14 days before heading. Range: 1000.-3000.

WGRMX  = 0.0000249 ! Maximum individual grain weight (kg grain-1)

NSP_FRC = 0          ! simulate NSP
!NSP_FRC = 2          ! force NSP to observed value 
NSP_OBS = 400000000. ! Observed number of spikelets per hectare

* pvo20130507: new input parameters for subroutine SUBGREC
* (1) Under source limitation some grains will be only partially filled
* A crop with GFRCP = 1 tries to fill completely as much as possible of its grains; the remaining are partially filled at very low weight (almost empty)
* A crop with GFRCP = 0 produces 0 completely filled grains but many, relatively heavy, partially filled grains 
* GFRCP = 1 is most realistic and conform simulations with original ORYZA2000v2n13 model
* (2) All grains (partially and completely filled) heavier than WGREC contribute to the yield that can be commercially sold
*GFRCP  = 0.9       ! Grain Filling Ratio Complete / Partial (0 to 1). 
GFRCP  = 1.0       ! Grain Filling Ratio Complete / Partial (0 to 1). 
WGREC  = 0.0000200 ! Weight GRain EConomic (kg grain-1)

