                   ! is stored as reserves (-)
TCLSTR = 10.       ! Time coefficient for loss of stem reserves (1 d-1)
SPGF   = 64900.    ! Spikelet growth factor (no kg-1) ! value for IR72
!SPGF   = 52000.    ! Spikelet growth factor (no kg-1) ! ~0.8*64900, for sensitivity analysis
!SPGF   = 32450.    ! Spikelet growth factor (no kg-1) ! ~0.5*64900, for sensitivity analysis
